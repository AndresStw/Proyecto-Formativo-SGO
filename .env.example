# ============================================================
#  Sabor Caleño SGO — Environment Variables Example
# ============================================================
# INSTRUCTIONS:
#   1. Copy this file to ".env" → cp .env.example .env
#   2. Ensure XAMPP (MySQL) is running.
#   3. Do NOT upload the ".env" file to the repository.
# ============================================================

APP_NAME=Sabor Caleño SGO
APP_ENV=development
DEBUG=true

# Database Config (MySQL / XAMPP Local)
# Format: mysql+pymysql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=mysql+pymysql://root:@localhost:3306/sabor_caleno_sgo

# JWT Config (for Authentication)
JWT_SECRET_KEY=super-secret-key-cambia-esto-en-produccion
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# Frontend URLs allowed to connect
CORS_ORIGINS=http://localhost:5173,http://localhost:3000