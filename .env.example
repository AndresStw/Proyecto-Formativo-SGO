# ============================================================
#  Sabor Caleño SGO — Variables de entorno de ejemplo
# ============================================================
# INSTRUCCIONES:
#   1. Copia este archivo a ".env"  →  cp .env.example .env
#   2. Pide la contraseña real de Supabase por el canal privado del equipo
#   3. Reemplaza TU_PASSWORD en DATABASE_URL
#   4. NUNCA subas ".env" al repositorio
# ============================================================

APP_NAME=Sabor Caleño SGO
APP_ENV=development
DEBUG=true

# Supabase — Transaction Pooler (puerto 6543) — NO usar Direct Connection (5432)
# Prefijo OBLIGATORIO:  postgresql+psycopg://
# Usuario: postgres.<REF_DEL_PROYECTO>
# Host:    aws-0-<REGION>.pooler.supabase.com
DATABASE_URL=postgresql+psycopg://postgres.uujhpovcxhspijronwbq:TU_PASSWORD@aws-0-us-east-2.pooler.supabase.com:6543/postgres

CORS_ORIGINS=http://localhost:5173,http://localhost:3000